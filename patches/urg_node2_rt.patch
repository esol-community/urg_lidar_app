diff --git a/src/urg_node2_main.cpp b/src/urg_node2_main.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..4b8a2ca97088ac748194a94c7b3279f93d30e686
--- /dev/null
+++ b/src/urg_node2_main.cpp
@@ -0,0 +1,31 @@
+// Copyright 2026
+// SPDX-License-Identifier: Apache-2.0
+
+#include <exception>
+#include <iostream>
+#include <memory>
+
+#include "urg_node2/urg_node2.hpp"
+#include "rclcpp_realtime/rclcpp_realtime.hpp"
+
+int main(int argc, char ** argv)
+{
+  int status = 0;
+  bool initialized = false;
+  try {
+    rclcpp_realtime::init(argc, argv);
+    initialized = true;
+    auto node = std::make_shared<urg_node2::UrgNode2>(rclcpp::NodeOptions{});
+    rclcpp_realtime::SchedParamExecutorOptions options;
+    rclcpp_realtime::executors::SchedParamSingleThreadedExecutor executor(options);
+    executor.add_node(node->get_node_base_interface());
+    executor.spin();
+  } catch (const std::exception & error) {
+    std::cerr << "urg_node2: " << error.what() << std::endl;
+    status = 1;
+  }
+  if (initialized) {
+    rclcpp_realtime::shutdown();
+  }
+  return status;
+}
