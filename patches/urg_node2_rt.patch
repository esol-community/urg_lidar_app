index 36e3214703fbd3c4faeb65d0bbf5bd3e00c8cf7a..03c0706dd056c24980b447bdace68828ac54f92d 100644
--- a/src/urg_node2.cpp
+++ b/src/urg_node2.cpp
@@ -13,6 +13,11 @@
 // limitations under the License.
 
 #include "urg_node2/urg_node2.hpp"
+#include <cstring>
+#include <optional>
+#include "rcpputils/scope_exit.hpp"
+#include "rcl_realtime/context.h"
+#include "rclcpp_realtime/contexts/realtime_argument.hpp"
 
 namespace urg_node2
 {
@@ -701,7 +706,31 @@ void UrgNode2::start_thread(void)
 {
   // スレッド終了フラグのクリア
   close_thread_ = false;
-  scan_thread_ = std::thread(std::bind(&UrgNode2::scan_thread, this));
+  // Use the same realtime context as the executor, with a separate scan tag.
+  rclcpp_realtime::contexts::RealtimeArguments realtime_arguments;
+  const auto context = get_node_base_interface()->get_context()->get_rcl_context();
+  const auto context_id = rcl_context_get_instance_id(context.get());
+  std::optional<rcpputils::ThreadAttribute> thread_attribute;
+  rcutils_thread_attrs_t attributes{};
+  if (realtime_arguments.get_thread_attrs(context_id, &attributes)) {
+    RCPPUTILS_SCOPE_EXIT(
+      const auto cleanup_result = rcutils_thread_attrs_fini(&attributes);
+      (void)cleanup_result;
+    );
+    for (size_t i = 0; i < attributes.num_attributes; ++i) {
+      const auto & attribute = attributes.attributes[i];
+      if (attribute.tag && std::strcmp(attribute.tag, "URG_SCAN_THREAD") == 0) {
+        thread_attribute.emplace(attribute);
+        break;
+      }
+    }
+  }
+  if (thread_attribute) {
+    scan_thread_ = rcpputils::Thread(*thread_attribute, &UrgNode2::scan_thread, this);
+    RCLCPP_INFO(get_logger(), "Applied realtime attributes: URG_SCAN_THREAD");
+  } else {
+    scan_thread_ = rcpputils::Thread(&UrgNode2::scan_thread, this);
+  }
 }
 
